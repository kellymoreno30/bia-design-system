# Figma API Configuration
# Obtén tu token en: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=tu_token_aqui

# ID del archivo de Figma (se encuentra en la URL del archivo)
# Ejemplo: https://www.figma.com/file/ABC123xyz/BIA-PULSE
# El FILE_ID es: ABC123xyz
FIGMA_FILE_ID=tu_file_id_aqui
